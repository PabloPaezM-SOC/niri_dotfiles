// Startup Applications
spawn-sh-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &"
spawn-at-startup "awww-daemon"
spawn-at-startup "waybar"
spawn-at-startup "sh" "-c" "vicinae server &"
spawn-at-startup "swaync"
spawn-at-startup "xwayland-satellite"

// General Settings
prefer-no-csd
screenshot-path "~/Imágenes/Screenshots/%Y-%m-%d %H-%M-%S.png"
output "eDP-1" {
    mode "1920x1080@60.024"
    scale 1
}

input {
    keyboard {
        xkb {
            layout "es"

        }
    }
    //focus-follows-mouse
    workspace-auto-back-and-forth
}

gestures {
  hot-corners {
    off
  }
}



hotkey-overlay {
    skip-at-startup
}

cursor {
    hide-when-typing
    hide-after-inactive-ms 5000
}

overview {
    backdrop-color "#1E1E2E"
    workspace-shadow {
        off
    }
}

layer-rule {
    match namespace="^awww-daemon$"
    place-within-backdrop true
}

binds {
    // Shortcuts Panel
    MOD+SHIFT+ESCAPE                  { show-hotkey-overlay; }

    // Application Shortcuts
    MOD+T                               hotkey-overlay-title="Open Terminal: kitty" { spawn-sh "kitty"; }
    MOD+SHIFT+Q                         hotkey-overlay-title="Lock Screen: gtklock" { spawn-sh "gtklock"; }
    MOD+SPACE                           hotkey-overlay-title="Open App Launcher: vicinae" { spawn-sh "vicinae toggle"; }
    MOD+B                               hotkey-overlay-title="Open Browser: zen" { spawn-sh "zen-browser"; }
    MOD+SHIFT+E                         hotkey-overlay-title="File Manager: Thunar" { spawn-sh "DISPLAY=:2 thunar"; }
    MOD+E                               hotkey-overlay-title="File Manager: Yazi" { spawn-sh "kitty yazi"; }
    MOD+W                               hotkey-overlay-title="Open Wallpaper Selector" { spawn-sh "$HOME/.config/scripts/bgselector.sh"; }

    // Media Keys

    XF86AudioRaiseVolume                allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume                allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-";}
    XF86MonBrightnessUp                 allow-when-locked=true { spawn-sh "mediactl brightness_up"; }
    XF86MonBrightnessDown               allow-when-locked=true { spawn-sh "mediactl brightness_down"; }
    XF86AudioMute                       allow-when-locked=true { spawn-sh "mediactl volume_mute"; }
    XF86AudioMicMute                    allow-when-locked=true { spawn-sh "mediactl mic_mute"; }
    XF86AudioNext                       allow-when-locked=true { spawn-sh "mediactl next_track"; }
    XF86AudioPause                      allow-when-locked=true { spawn-sh "mediactl play_pause"; }
    XF86AudioPlay                       allow-when-locked=true { spawn-sh "mediactl play_pausse"; }
    XF86AudioPrev                       allow-when-locked=true { spawn-sh "mediactl prev_track"; }

    // Window Management
    MOD+Q                               { close-window; }

    MOD+H                               { focus-column-left; }
    MOD+J                               { focus-workspace-up; }
    MOD+K                               { focus-workspace-down; }
    MOD+L                               { focus-column-right; }

    MOD+LEFT                            { focus-column-left; }
    MOD+DOWN                            { focus-workspace-down; }
    MOD+UP                              { focus-workspace-up; }
    MOD+RIGHT                           { focus-column-right; }

    // Move windows within workspace
    //MOD+SHIFT+LEFT                    { move-column-left; }
    MOD+SHIFT+DOWN                      { move-column-to-workspace-down; }
    MOD+SHIFT+UP                        { move-column-to-workspace-up; }
    //MOD+SHIFT+RIGHT                     { move-column-right; }

    // Move windows floating within workspace
    MOD+SHIFT+LEFT    { move-column-left-or-to-monitor-left; }
    MOD+SHIFT+RIGHT   { move-column-right-or-to-monitor-right; }



    // Move to workspace edges
    MOD+SHIFT+HOME                      { move-column-to-first; }
    MOD+SHIFT+END                       { move-column-to-last; }

    MOD+HOME                            { focus-column-first; }
    MOD+END                             { focus-column-last; }

    // Monitor Management - Move between monitors
    MOD+CTRL+LEFT                       { focus-monitor-left; }
    MOD+CTRL+RIGHT                      { focus-monitor-right; }
    MOD+CTRL+UP                         { focus-monitor-up; }
    MOD+CTRL+DOWN                       { focus-monitor-down; }

    MOD+CTRL+H                          { focus-monitor-left; }
    MOD+CTRL+L                          { focus-monitor-right; }
    MOD+CTRL+K                          { focus-monitor-up; }
    MOD+CTRL+J                          { focus-monitor-down; }

    // Move windows to different monitors
    MOD+SHIFT+CTRL+LEFT                 { move-column-to-monitor-left; }
    MOD+SHIFT+CTRL+RIGHT                { move-column-to-monitor-right; }
    MOD+SHIFT+CTRL+UP                   { move-column-to-monitor-up; }
    MOD+SHIFT+CTRL+DOWN                 { move-column-to-monitor-down; }

    MOD+SHIFT+CTRL+H                    { move-column-to-monitor-left; }
    MOD+SHIFT+CTRL+L                    { move-column-to-monitor-right; }
    MOD+SHIFT+CTRL+K                    { move-column-to-monitor-up; }
    MOD+SHIFT+CTRL+J                    { move-column-to-monitor-down; }

    // Workspace Management
    MOD+TAB                             hotkey-overlay-title="Open Overview" repeat=false { toggle-overview; }
    MOD+WHEELSCROLLDOWN                 cooldown-ms=100 { focus-workspace-down; }
    MOD+WHEELSCROLLUP                   cooldown-ms=100 { focus-workspace-up; }

    // Move windows to different workspaces - using wheel matches K/J pattern
    MOD+SHIFT+WHEELSCROLLDOWN           cooldown-ms=100 { move-column-to-workspace-down; }
    MOD+SHIFT+WHEELSCROLLUP             cooldown-ms=100 { move-column-to-workspace-up; }

    // Column navigation with mouse
    MOD+WHEELSCROLLRIGHT                { focus-column-right; }
    MOD+WHEELSCROLLLEFT                 { focus-column-left; }
    MOD+SHIFT+WHEELSCROLLRIGHT          { move-column-right; }
    MOD+SHIFT+WHEELSCROLLLEFT           { move-column-left; }

    // Numbered Workspaces
    MOD+1                               { focus-workspace "uno"; }
    MOD+2                               { focus-workspace "dos"; }
    MOD+3                               { focus-workspace "tres"; }
    MOD+4                               { focus-workspace "cuatro"; }
    MOD+5                               { focus-workspace "cinco"; }
    MOD+6                               { focus-workspace "seis"; }
    MOD+7                               { focus-workspace "siete"; }
    MOD+8                               { focus-workspace "ocho"; }
    MOD+9                               { focus-workspace "nueve"; }

    // Move windows to numbered workspaces with MOD+SHIFT
    MOD+SHIFT+1                         { move-column-to-workspace "uno"; }
    MOD+SHIFT+2                         { move-column-to-workspace "dos"; }
    MOD+SHIFT+3                         { move-column-to-workspace "tres"; }
    MOD+SHIFT+4                         { move-column-to-workspace "cuatro"; }
    MOD+SHIFT+5                         { move-column-to-workspace "cinco"; }
    MOD+SHIFT+6                         { move-column-to-workspace "seis"; }
    MOD+SHIFT+7                         { move-column-to-workspace "siete"; }
    MOD+SHIFT+8                         { move-column-to-workspace "ocho"; }
    MOD+SHIFT+9                         { move-column-to-workspace "nueve"; }

    //MOD+TAB                             { focus-workspace-previous; }

    // Layout Controls
    MOD+C                               { center-column; }
    MOD+SHIFT+C                         { center-visible-columns; }
    MOD+BRACKETLEFT                     { set-column-width "-10%"; }
    MOD+BRACKETRIGHT                    { set-column-width "+10%"; }
    MOD+SHIFT+BRACKETLEFT               { set-window-height "-10%"; }
    MOD+SHIFT+BRACKETRIGHT              { set-window-height "+10%"; }

    // Window resizing with mouse
    // MOD+CTRL+WHEELSCROLLDOWN            { set-window-height "-5%"; }
    // MOD+CTRL+WHEELSCROLLUP              { set-window-height "+5%"; }

    // Window Modes
    MOD+F                               { toggle-window-floating; }
    //MOD+F                             { fullscreen-window; }
    MOD+M                               { maximize-column; }
    MOD+O                               { toggle-column-tabbed-display; }

    // Utils
    MOD+S                               { screenshot; }
    MOD+SHIFT+S                         { screenshot-screen write-to-disk=true; }
    MOD+CTRL+S                          { screenshot-window write-to-disk=true; }
    MOD+P                               { spawn-sh "pgrep -x hyprpicker >/dev/null || hyprpicker"; }

    // Application Restarts
    MOD+ALT+W                           { spawn "sh" "-c" "pgrep -x waybar >/dev/null && killall waybar || waybar &"; }
    // use with toggle in waybar (doens't restart if not running)
    // MOD+ALT+W                        { spawn "killall" "-SIGUSR1" "waybar"; }
}

// Layout Settings
layout {
    gaps 8
    center-focused-column "never"
    background-color "transparent"

    border {
      width 1
      active-color "#C1C1C1"
      inactive-color "#C1C1C1"
    }


    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
        width 1
        active-color "#C1C1C1"


    }

    shadow {
      on
      softness 2
      spread 1
      offset x=4 y=6
      draw-behind-window true
      color "#00000070"
      // inactive-color "#00000054"
    }

    /* insert-hint {
        off
        color "#000000"
    }

    struts {}
    */

}

// Animation Settings
animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    window-close {
        duration-ms 200
        curve "ease-out-cubic"
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1200 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 300
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
}



// Window Rules
// Application-specific rules
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}


window-rule {
    match app-id=r#"zen-browser"#
    match app-id=r#"obsidian$"#
    open-maximized true
}

// File dialogs - Open/Save/Select
//window-rule {
//   match title=r#".*(Open|Save|Select).*"#
//   open-floating true
 //   default-column-width { proportion 0.0; }
 //   max-width 800
 //   max-height 1000
//}

/*window-rule {
    match title=r#".*File.*"#
    open-floating true
    default-column-width { proportion 0.0; }
    max-width 800
    max-height 1000
}*/

window-rule {
    match app-id=r#"org\.gtk\.FileChooserDialog"#
    open-floating true
    default-column-width { proportion 0.0; }
    max-width 800
    max-height 1000
}

window-rule {
    match title=r#".*Sign in - Google Accounts — zen-browser"#
    open-floating true
}

// System dialogs
window-rule {
    match title=r#".*(Dialog|Properties|Preferences|Settings|Rename).*"#
    open-floating true
}

window-rule {
    match app-id=r#"zenity"#
    open-floating true
}

// Authentication dialogs
window-rule {
    match app-id=r#"org\.kde\.polkit-kde-authentication-agent-1"#
    open-floating true
}

window-rule {
    match title=r#".*Authentication.*"#
    open-floating true
}

// Password managers
window-rule {
    match app-id=r#"org\.keepassxc\.KeePassXC"# title=r#".*Auto-Type.*"#
    open-floating true
}

window-rule {
    match app-id=r#"Bitwarden"# title=r#".*unlock.*"#
    open-floating true
}

// Notification and system utilities
window-rule {
    match app-id=r#"nm-connection-editor"#
    open-floating true
}

window-rule {
    match app-id=r#"blueman-manager"#
    open-floating true
}

window-rule {
    match app-id=r#"pavucontrol"#
    open-floating true
}

// Steam dialogs
window-rule {
  match app-id=r#"steam"# title=r#".*(Friends|Settings|Properties|Lista de amigos|Parámetros de Steam).*"#
  open-floating true
}

// Workspaces


workspace "uno"
workspace "dos"
//workspace "5"
//aworkspace "6"
//workspace "7"
//workspace "8"
//workspace "9"

// Global window appearance
window-rule {
    //match is-active=true
    geometry-corner-radius 1
    clip-to-geometry true
    opacity 1.0
    background-effect {
        blur true
    }

}

// Inactive window transparency
window-rule {
    match is-active=false
    geometry-corner-radius 1
    clip-to-geometry true
    opacity 1.0
    background-effect {
        blur true
    }


}

window-rule {
  match app-id=r#"vesktop"#
  match app-id=r#"obsidian"#
  open-on-workspace "dos"
  open-maximized true
}

window-rule{
  match app-id=r#"zen"#
  open-on-workspace "uno"
  open-maximized true
}

window-rule {
    match app-id="waybar"
    // Esto fuerza a Niri a tratar la barra con decoraciones de ventana
    // Aunque Niri es minimalista, esto es lo que permite que el compositor
    // dibuje la sombra fuera del área de contenido.
}


// Environment Variables
environment {
    DISPLAY null
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    XDG_SESSION_TYPE "wayland"
    XDG_CURRENT_DESKTOP "niri"

    // Wayland Platform Settings
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_QPA_PLATFORMTHEME_QT6 "gtk3"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"

    // GTK Settings
    GDK_BACKEND "wayland,x11"

    // Firefox Wayland
    MOZ_ENABLE_WAYLAND "1"
    MOZ_DBUS_REMOTE "1"

    // Java Applications
    _JAVA_AWT_WM_NONREPARENTING "1"

    // SDL Applications
    SDL_VIDEODRIVER "wayland"

    // CLUTTER Applications
    CLUTTER_BACKEND "wayland"

    // Performance
    VDPAU_DRIVER "va_gl"
    LIBVA_DRIVER_NAME "iHD"
}

